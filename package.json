{
  "name": "tele-rag",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/website.mjs",
    "build": "node scripts/website.mjs --build",
    "preview": "node scripts/website.mjs --preview",
    "setup:supabase": "tsx scripts/setup-supabase.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json",
    "test": "node --test scripts/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run test:ui && npm run build",
    "doctor": "node scripts/doctor.mjs",
    "smoke:providers": "node scripts/provider-smoke.mjs",
    "test:ui": "vitest run"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@supabase/supabase-js": "2.76.1",
    "fflate": "^0.8.3",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-pgvector": "^0.0.13",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
