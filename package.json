    "smoke:providers": "node scripts/provider-smoke.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@supabase/supabase-js": "2.76.1",
    "fflate": "^0.8.3",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-pgvector": "^0.0.13",
    "@types/node": "^20.19.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  }
}
